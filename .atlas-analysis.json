  "keyFeatures": [
    "REPL-based agent loop: LLM writes Python code, observes results, and iterates until task completion",
    "Recursive agent composition with automatic cost tracking and propagating context",
    "Tools as plain Python functions — signature and docstring become the agent's description",
    "Extensible hook system using typed events (InvokeEnter, LLMQueryEnter, REPLExecEnter) and effects",
    "Built-in hooks for budget control, iteration/recursion limits, logging, tracing, and replay",
    "LiteLLM default backend routing to every major provider (OpenAI, Anthropic, Gemini, Bedrock, ...)",
    "Custom LLM backends via BaseLLM subclass; local OpenAI-compatible servers with zero code",
    "jaz.scope for ambient inputs that propagate through nested invoke trees without manual threading",
    "jaz.describe to attach prompt descriptions to values that travel into nested invokes",
    "Interactive jaz console REPL with Python 3.14 t-string support",
    "Trajectory recording and replay via ATIF format; Langfuse/Jaeger/OTel tracing presets",
    "Async support via ainvoke for top-level await in agent code"
  ],
  "publicApiSurface": [
    "jaz.invoke(*hooks, **inputs) -> object",
    "jaz.ainvoke(*hooks, **inputs) -> object",
    "jaz.configure(*, llm, repl, protocol)",
    "jaz.ConfigOverride(*, llm, repl, protocol)",
    "jaz.get_config() -> Config",
    "jaz.scope(**values) -> ContextManager",
